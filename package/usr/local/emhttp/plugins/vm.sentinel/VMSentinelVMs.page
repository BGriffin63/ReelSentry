Menu="VMSentinel"
Title="VMs"
---
<?php
/* VM Sentinel — Per-VM configuration (spec §8, §13.2). SPDX-License-Identifier: MIT */
require_once '/usr/local/emhttp/plugins/vm.sentinel/include/vms-common.php';
$cfg = vms_read_config();
$inv = vms_inventory();
// Merge retained (deleted) VMs so history/config can still be managed (spec §8).
$all = $inv;
foreach (($cfg['vms'] ?? []) as $uuid => $ov) if (!isset($all[$uuid])) $all[$uuid] = ($ov['name'] ?? $uuid).' (unavailable)';
$csrf=''; if (is_readable('/var/local/emhttp/var.ini')){$v=@parse_ini_file('/var/local/emhttp/var.ini');$csrf=$v['csrf_token']??'';}
function ck($cfg,$uuid,$k,$def){ return (int)($cfg['vms'][$uuid][$k] ?? $cfg[$k] ?? $def); }
function vv($cfg,$uuid,$k,$def){ return h((string)($cfg['vms'][$uuid][$k] ?? $def)); }
?>
<link rel="stylesheet" href="/plugins/vm.sentinel/vms.css">
<script>window.VMS_CSRF=<?=json_encode($csrf)?>;</script>
<script src="/plugins/vm.sentinel/vms.js"></script>
<div class="vms-wrap">
  <?php include __DIR__.'/include/nav.php'; vms_nav('vms'); ?>
  <p class="vms-help">Settings are stored per VM by its UUID, so they survive a rename. Deleting a VM in
  Unraid does not erase its history here — use “Forget” to remove retained settings.</p>

  <?php if (!$all): ?>
    <p class="vms-muted">No VMs discovered yet.</p>
  <?php endif; ?>

  <?php foreach ($all as $uuid => $name):
      $isRetained = !isset($inv[$uuid]); $htype = (string)($cfg['vms'][$uuid]['health_type'] ?? 'none'); ?>
  <details class="vms-vm">
    <summary><?=h($name)?> <span class="vms-uuid"><?=h($uuid)?></span></summary>
    <div class="body">
      <form onsubmit="event.preventDefault();VMS.saveForm(this,this.querySelector('.vms-flash'));">
        <input type="hidden" name="action" value="save_vm">
        <input type="hidden" name="uuid" value="<?=h($uuid)?>">
        <input type="hidden" name="name" value="<?=h(is_string($name)?$name:'')?>">
        <label><input type="checkbox" name="enabled" value="1" <?=ck($cfg,$uuid,'enabled',1)?'checked':''?>> Monitor this VM</label>
        <fieldset><legend>Notify on</legend>
          <?php foreach (['notify_start'=>'Start','notify_stop'=>'Stop','notify_shutdown'=>'Shutdown',
                          'notify_crash'=>'Crash / failure','notify_pause'=>'Pause','notify_resume'=>'Resume',
                          'notify_reboot'=>'Reboot','notify_health_fail'=>'Health check fails',
                          'notify_health_recover'=>'Health check recovers'] as $k=>$lbl): ?>
            <label style="display:inline-block;min-width:190px"><input type="checkbox" name="<?=$k?>" value="1" <?=ck($cfg,$uuid,$k, in_array($k,['notify_stop','notify_shutdown','notify_crash','notify_health_fail','notify_health_recover'])?1:0)?'checked':''?>> <?=$lbl?></label>
          <?php endforeach; ?>
        </fieldset>
        <fieldset><legend>Health check</legend>
          <label>Type:
            <select name="health_type">
              <?php foreach (['none'=>'Disabled','icmp'=>'Ping (ICMP)','tcp'=>'TCP port','agent'=>'QEMU guest agent'] as $k=>$lbl): ?>
                <option value="<?=$k?>" <?=$htype===$k?'selected':''?>><?=$lbl?></option>
              <?php endforeach; ?>
            </select>
          </label>
          <label>Target host/IP: <input type="text" name="health_target" value="<?=vv($cfg,$uuid,'health_target','')?>" placeholder="192.168.1.50"></label>
          <label>TCP port: <input type="number" name="health_port" min="1" max="65535" value="<?=vv($cfg,$uuid,'health_port','')?>"></label>
          <br>
          <label>Interval (s): <input type="number" name="health_interval" min="30" value="<?=vv($cfg,$uuid,'health_interval','60')?>"></label>
          <label>Timeout (s): <input type="number" name="health_timeout" min="1" value="<?=vv($cfg,$uuid,'health_timeout','5')?>"></label>
          <label>Fail threshold: <input type="number" name="health_fail_threshold" min="1" value="<?=vv($cfg,$uuid,'health_fail_threshold','3')?>"></label>
          <label>Recover threshold: <input type="number" name="health_recover_threshold" min="1" value="<?=vv($cfg,$uuid,'health_recover_threshold','2')?>"></label>
          <label>Startup grace (s): <input type="number" name="startup_grace" min="0" value="<?=vv($cfg,$uuid,'startup_grace','120')?>"></label>
        </fieldset>
        <button type="submit">Save</button>
        <?php if ($isRetained): ?>
          <button type="button" onclick="if(confirm('Forget retained settings for this VM?'))VMS.post({action:'forget_vm',uuid:'<?=h($uuid)?>'}).then(()=>location.reload());">Forget</button>
        <?php endif; ?>
        <span class="vms-flash"></span>
      </form>
    </div>
  </details>
  <?php endforeach; ?>
</div>
