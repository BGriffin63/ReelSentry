#!/usr/bin/env bash
# ReelSentry — service supervisor (spec §7, §20). Started by the .plg and on
# array-start; stopped on plugin removal / array-stop. Opens NO inbound port.
# SPDX-License-Identifier: MIT

set -u
VMS_PLUGIN_ROOT="${VMS_PLUGIN_ROOT:-/usr/local/emhttp/plugins/reelsentry}"
VMS_LIBDIR="${VMS_LIBDIR:-${VMS_PLUGIN_ROOT}/lib}"
export VMS_LIBDIR
export VMS_NOTIFYDIR="${VMS_NOTIFYDIR:-${VMS_PLUGIN_ROOT}/notifications}"
# shellcheck source=/dev/null
. "${VMS_LIBDIR}/common.sh"; . "${VMS_LIBDIR}/log.sh"

PROC_PID="${VMS_RUN_DIR}/processor.pid"
HEALTH_PID="${VMS_RUN_DIR}/health.pid"

_alive() { local p; p=$(cat "$1" 2>/dev/null) || return 1; [ -n "$p" ] && kill -0 "$p" 2>/dev/null; }

svc_start() {
    vms_mkrundirs || { vms_log_error service "cannot create runtime dirs"; return 1; }
    # Repair the hook idempotently on every start (self-healing after upgrades).
    bash "${VMS_PLUGIN_ROOT}/hooks/install-hook.sh" install >/dev/null 2>&1 || \
        vms_log_warning service "hook install reported an issue"

    if ! _alive "$PROC_PID"; then
        nohup bash "${VMS_PLUGIN_ROOT}/services/processor.sh" loop >/dev/null 2>&1 &
        echo $! > "$PROC_PID"
        vms_log_info service "processor started pid $(cat "$PROC_PID")"
    fi
    if ! _alive "$HEALTH_PID"; then
        nohup bash "${VMS_PLUGIN_ROOT}/services/healthcheck.sh" loop >/dev/null 2>&1 &
        echo $! > "$HEALTH_PID"
        vms_log_info service "healthcheck started pid $(cat "$HEALTH_PID")"
    fi
    return 0
}

svc_stop() {
    local p
    for f in "$PROC_PID" "$HEALTH_PID"; do
        p=$(cat "$f" 2>/dev/null) || continue
        [ -n "$p" ] && kill "$p" 2>/dev/null || true
        rm -f "$f" 2>/dev/null
    done
    vms_log_info service "services stopped"
    return 0
}

svc_status() {
    _alive "$PROC_PID" && echo "processor: running ($(cat "$PROC_PID"))" || echo "processor: stopped"
    _alive "$HEALTH_PID" && echo "healthcheck: running ($(cat "$HEALTH_PID"))" || echo "healthcheck: stopped"
}

case "${1:-status}" in
    start)   svc_start ;;
    stop)    svc_stop ;;
    restart) svc_stop; sleep 1; svc_start ;;
    status)  svc_status ;;
    *) echo "usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
